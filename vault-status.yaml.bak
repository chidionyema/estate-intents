name: vault-status
description: >
  Composite intent. Check ClusterSecretStore and SecretStore health.
args:
  namespace: {type: string, default: "vault"}
  kubeconfig: {type: string, default: ""}
steps:
  - name: cluster-secret-stores
    intent: kubectl-list
    args:
      resource: clustersecretstores
      output: json
  - name: secret-stores
    intent: kubectl-list
    args:
      resource: secretstores
      namespace: "{{namespace}}"
      output: json
  - name: summary
    cmd: >
      python3 -c "
import sys,json
print('ClusterSecretStore status:')
for key in ['clustersecretstores','secretstores']:
  try:
    d=json.load(sys.stdin)
    items=d.get('items',[]) if isinstance(d,dict) else []
    for s in items:
      name=s['metadata']['name']
      ns=s['metadata'].get('namespace','cluster')
      cond=s.get('status',{}).get('conditions',[])
      ok='OK' if any(c.get('type')=='Ready' for c in cond) else 'FAIL'
      print(f'  [{ok}] {ns}/{name}')
  except: pass
"
